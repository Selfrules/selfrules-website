{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/it/home",
      "destination": "/it",
      "permanent": true
    },
    {
      "source": "/21lab-extra",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSf019KSKDn5P0ZLBDbd8BRKlrCK2GpQKpe1NWXsCdv8Yw7Fdw/viewform",
      "permanent": false
    },
    {
      "source": "/extra",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSf019KSKDn5P0ZLBDbd8BRKlrCK2GpQKpe1NWXsCdv8Yw7Fdw/viewform",
      "permanent": false
    }
  ]
}
