{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:lingua(it|en)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/about",
      "destination": "/come-lavoro",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/contact",
      "destination": "/#scrivimi",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/work",
      "destination": "/storie",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/work/payments-rescue",
      "destination": "/storie/pagamenti",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/work/cashless-system",
      "destination": "/storie/pagamenti",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/work/leadsbridge-redesign",
      "destination": "/storie/leadsbridge",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/notes",
      "destination": "/note",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/notes/the-meeting-where-everyone-says-yes",
      "destination": "/note/riunione-dove-tutti-dicono-si",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/notes/why-i-prototype-in-code",
      "destination": "/note/perche-prototipo-in-codice",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/notes/:resto*",
      "destination": "/note",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/lab",
      "destination": "/adesso",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/lab/:resto*",
      "destination": "/adesso",
      "permanent": false
    },
    {
      "source": "/:lingua(it|en)/:resto*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/21lab-extra",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSf019KSKDn5P0ZLBDbd8BRKlrCK2GpQKpe1NWXsCdv8Yw7Fdw/viewform",
      "permanent": false
    },
    {
      "source": "/extra",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSf019KSKDn5P0ZLBDbd8BRKlrCK2GpQKpe1NWXsCdv8Yw7Fdw/viewform",
      "permanent": false
    }
  ]
}
